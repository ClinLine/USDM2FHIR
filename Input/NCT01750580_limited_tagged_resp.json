                "extensionAttributes": [],
                "notes": [],
                "endpoints": [
                  {
                    "id": "a1f75514-921d-11f1-aba2-8abdedc76cb3",
                    "name": "Endpoint_a1f75514-921d-11f1-aba2-8abdedc76cb3",
                    "text": "<p>Objective response rate (ORR) [Time Frame: From baseline until the earliest of documented disease progression, initiation of new anticancer therapy, or the primary outcome data cutoff, assessed up to 24 months.]<\/p>",
                    "description": "Proportion of participants with a best overall response of complete response or partial response according to RECIST version 1.1, as assessed by investigators. Tumor assessments were performed at baseline, every two treatment cycles during induction (each treatment cycle was 21 days), and approximately every 6-9 weeks during maintenance.",
                    "level": {
                      "id": "Code_419",
                      "code": "C94496",
                      "decode": "Primary Endpoint",
                      "codeSystem": "http:\/\/www.cdisc.org",
                      "codeSystemVersion": "2025-09-26",
                      "instanceType": "Code"
                    },
                    "extensionAttributes": [],
                    "notes": [],
                    "purpose": "",
                    "instanceType": "Endpoint"
                  }
                ],
                "instanceType": "Objective"
              },
              {
                "id": "Objective_1",
                "name": "SECONDARY",
                "label": "",
                "description": "",
                "text": "Secondary Objective",
                "dictionaryId": "",
                "level": {
                  "id": "Code_422",
                  "code": "C85827",
                  "decode": "Study Secondary Objective",
                  "codeSystem": "http:\/\/www.cdisc.org",
                  "codeSystemVersion": "2025-09-26",
                  "instanceType": "Code"
                },
                "extensionAttributes": [],
                "notes": [],
                "endpoints": [
                  {
                    "id": "a1f76392-921d-11f1-996c-8abdedc76cb3",
                    "name": "Endpoint_a1f76392-921d-11f1-996c-8abdedc76cb3",
                    "text": "<p>Disease control rate [Time Frame: From baseline until the earliest of documented disease progression, initiation of new anticancer therapy, or the tumor response data cutoff, assessed up to 24 months.]<\/p>",
                    "description": "Proportion of participants with a best overall response of complete response, partial response, or stable disease according to RECIST version 1.1, as assessed by investigators. Tumor assessments were performed at baseline, every two treatment cycles during induction (each treatment cycle was 21 days), and approximately every 6-9 weeks during maintenance.",
                    "level": {
                      "id": "Code_421",
                      "code": "C139173",
                      "decode": "Secondary Endpoint",
                      "codeSystem": "http:\/\/www.cdisc.org",
                      "codeSystemVersion": "2025-09-26",
                      "instanceType": "Code"
                    },
                    "extensionAttributes": [],
                    "notes": [],
                    "purpose": "",
                    "instanceType": "Endpoint"
                  },
                  {
                    "id": "a1f765e0-921d-11f1-98a6-8abdedc76cb3",
                    "name": "Endpoint_a1f765e0-921d-11f1-98a6-8abdedc76cb3",
                    "text": "<p>Progression-Free Survival (PFS) [Time Frame: From the first dose of study treatment to the first documented disease progression according to RECIST v1.1 or death from any cause, whichever occurred first, assessed up to 36 months.]<\/p>",
                    "description": "Progression-free survival was defined as the time from the first dose of study treatment to the first documented disease progression according to RECIST version 1.1 or death from any cause, whichever occurred first.",
                    "level": {
                      "id": "Code_423",
                      "code": "C139173",
                      "decode": "Secondary Endpoint",
                      "codeSystem": "http:\/\/www.cdisc.org",
                      "codeSystemVersion": "2025-09-26",
                      "instanceType": "Code"
                    },
                    "extensionAttributes": [],
                    "notes": [],
                    "purpose": "",
                    "instanceType": "Endpoint"
                  },
                  {
                    "id": "a1f767f2-921d-11f1-aea5-8abdedc76cb3",
                    "name": "Endpoint_a1f767f2-921d-11f1-aea5-8abdedc76cb3",
                    "text": "<p>Overall Survival (OS) [Time Frame: From the first dose of study treatment to death from any cause, assessed up to 36 months.]<\/p>",
                    "description": "Overall survival was defined as the time from the first dose of study treatment to death from any cause.",
                    "level": {
                      "id": "Code_424",
                      "code": "C139173",
                      "decode": "Secondary Endpoint",
                      "codeSystem": "http:\/\/www.cdisc.org",
                      "codeSystemVersion": "2025-09-26",
                      "instanceType": "Code"
                    },
                    "extensionAttributes": [],
                    "notes": [],
                    "purpose": "",
                    "instanceType": "Endpoint"
                  },
                  {
                    "id": "a1f769f0-921d-11f1-93bb-8abdedc76cb3",
                    "name": "Endpoint_a1f769f0-921d-11f1-93bb-8abdedc76cb3",
                    "text": "<p>Safety and Tolerability [Time Frame: From signing informed consent through 28 days after the last dose of study treatment.]<\/p>",
                    "description": "The incidence, type, and severity of adverse events, treatment-related adverse events, serious adverse events, and clinically significant abnormalities in laboratory test results and vital signs. Adverse events were graded according to NCI CTCAE version 5.0.",
                    "level": {
